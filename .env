# Servidor
SERVER_PORT=8080

# Strategy de persistência: redis | memory
STORAGE_TYPE=redis

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Janela de contagem em segundos (1 = requisições por segundo)
RATE_LIMIT_WINDOW_SECONDS=1

# Limite por IP (req/janela) e tempo de bloqueio em segundos
RATE_LIMIT_IP=10
BLOCK_DURATION_IP_SECONDS=300

# Limites específicos por token (token:limite, separados por vírgula)
RATE_LIMIT_TOKENS=abc123:100,xyz789:50

# Limite para tokens não listados acima (0 = tokens desconhecidos usam o limite por IP)
RATE_LIMIT_TOKEN_DEFAULT=0

# Tempo de bloqueio de token em segundos
BLOCK_DURATION_TOKEN_SECONDS=300

# Usar X-Forwarded-For / X-Real-IP para identificar o IP (apenas atrás de proxy confiável)
TRUST_FORWARDED_HEADERS=false
